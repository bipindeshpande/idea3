# Application
DEBUG=False
APP_NAME=Startup Discovery API

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/startup_discovery

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=True

# LLM Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4-turbo-preview

# Security
SECRET_KEY=change-me-in-production-use-strong-random-key

# Cache TTL (seconds)
CACHE_TTL_PROFILE=3600
CACHE_TTL_RECOMMENDATIONS=7200
CACHE_TTL_TOOLS=86400

# Pipeline
STAGE1_TIMEOUT=60
STAGE2_TIMEOUT=120
PARALLEL_EXECUTION=True

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
