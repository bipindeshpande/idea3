# Production Environment Variables
# Copy this file to production.env and fill in actual values
# DO NOT commit production.env to version control

# Application
APP_NAME=Startup Discovery SaaS
APP_VERSION=2.0.0
ENVIRONMENT=production
DEBUG=false

# Database
POSTGRES_USER=startup_discovery
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=startup_discovery
DATABASE_URL=postgresql://startup_discovery:CHANGE_ME_STRONG_PASSWORD@postgres:5432/startup_discovery

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0
REDIS_ENABLED=true

# LLM API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Default LLM Settings
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
MAX_TOKENS_STAGE1=2000
MAX_TOKENS_STAGE2=4000

# Security
SECRET_KEY=CHANGE_ME_GENERATE_STRONG_SECRET_KEY_32_CHARS_MIN
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOW_UNAUTHENTICATED=false

# CORS - Frontend domain
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
FRONTEND_DOMAIN=https://yourdomain.com

# Cache
CACHE_TTL_DISCOVERY=604800
CACHE_TTL_PROFILE=86400

# Pipeline
PARALLEL_EXECUTION=true
STAGE1_TIMEOUT=300

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Logging
LOG_LEVEL=INFO

# Monitoring & Error Tracking (Optional but Recommended)
# Get your DSN from https://sentry.io after creating a project
SENTRY_DSN=https://xxx@sentry.io/xxx