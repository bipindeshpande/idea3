# Development Dockerfile with hot-reload support
# Use this if you want to run frontend in container during development
# Otherwise, use: npm run dev (recommended for fastest hot-reload)
FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json* ./
RUN npm ci

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Start dev server with host binding for hot-reload
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

